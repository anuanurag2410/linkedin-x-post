# -------------------------------------------------
# TEXT GENERATION
# -------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=15m

# Optional OpenAI text fallback
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=

# -------------------------------------------------
# IMAGE GENERATION
# -------------------------------------------------
IMAGE_PROVIDER=drawthings
DRAWTHINGS_BIN=draw-things-cli
DRAWTHINGS_MODEL=flux_2_klein_4b_q8p.ckpt
DRAWTHINGS_STEPS=4
# DRAWTHINGS_MODELS_DIR=/Users/yourname/Library/Containers/com.liuliu.draw-things/Data/Documents/Models

# Optional OpenAI image fallback
OPENAI_IMAGE_MODEL=

# -------------------------------------------------
# REAL SOCIAL PUBLISHING - TEXT POSTS
# -------------------------------------------------
# LinkedIn token must include: openid, profile, w_member_social.
# The app resolves your member identifier automatically from /v2/userinfo.
LINKEDIN_ACCESS_TOKEN=
# Current active LinkedIn Marketing API version used by this app.
LINKEDIN_VERSION=202609

# X uses the free web composer flow.
# No X API token or billing is required.
