{
  "name": "linkedin-x-post",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup:local": "bash scripts/setup-local-ai.sh",
    "ai:check": "bash scripts/check-local-ai.sh",
    "dev:all": "bash scripts/dev-all.sh",
    "desktop": "npm run check:node && node scripts/desktop-dev.cjs",
    "desktop:build": "npm run check:node && npm run build && electron-builder --publish never",
    "desktop:build:mac": "npm run check:node && npm run build && electron-builder --mac dmg --arm64 --publish never",
    "desktop:build:win": "npm run check:node && npm run build && electron-builder --win nsis --x64 --publish never",
    "check:node": "node scripts/check-node.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "openai": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.7.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.datawithanurag.poststudio",
    "productName": "Post Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-runtime"
      },
      {
        "from": ".next/static",
        "to": "app-runtime/.next/static"
      },
      {
        "from": "public",
        "to": "app-runtime/public"
      },
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "public/brand/data-with-anurag-logo.png",
      "artifactName": "Post-Studio-macOS.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/brand/data-with-anurag-logo.png",
      "artifactName": "Post-Studio-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Post Studio"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
